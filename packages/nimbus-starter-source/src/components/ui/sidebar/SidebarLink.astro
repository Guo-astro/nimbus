---
/**
 * SidebarLink — a leaf row: `<a class="nb-sidebar-link">Label</a>`, with an
 * inner span only when a badge or the `leading` slot needs one. The row's
 * styling is the `nb-sidebar-link` class below — defined once, shipped with
 * the component so `nimbus-docs add`/`diff` carry it, overridable from your
 * own stylesheet.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import { Badge } from "@/components/ui/badge";
import type { SidebarBadge } from "@cloudflare/nimbus-docs/types";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props extends HTMLAttributes<"a"> {
  label: string;
  href: string;
  isCurrent?: boolean;
  badge?: SidebarBadge;
}

const { label, href, isCurrent, badge, class: className, ...attrs } = Astro.props;
const resolvedHref = withBase(href, import.meta.env.BASE_URL);
const hasLeading = Astro.slots.has("leading");
const plain = !hasLeading && !badge;
---

<a
  href={resolvedHref}
  aria-current={isCurrent ? "page" : undefined}
  data-nb-sidebar-link
  class={cn("nb-sidebar-link", className)}
  {...attrs}
>
  {plain ? (
    label
  ) : (
    <Fragment>
      <slot name="leading" />
      <span class="break-words">{label}</span>
      {badge &&
        (typeof badge === "string" ? (
          <Badge text={badge} />
        ) : (
          <Badge text={badge.text} variant={badge.variant} />
        ))}
    </Fragment>
  )}
</a>

<style is:global>
  /* `components` layer: callers' Tailwind utilities (a `px-1` or
     `line-through` on a row) still win, and your own unlayered overrides
     in globals.css win over both. */
  @layer components {
    .nb-sidebar-link {
      display: flex;
      min-height: 2rem;
      align-items: center;
      gap: 0.5rem;
      border-radius: 0.5rem;
      padding: 0.25rem 0.75rem;
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--color-muted-foreground);
      text-decoration: none;
      overflow-wrap: break-word;
    }
    .nb-sidebar-link:hover {
      background-color: var(--color-accent);
      color: var(--color-foreground);
    }
    .nb-sidebar-link:focus-visible {
      outline-offset: -2px;
    }
    .nb-sidebar-link[aria-current="page"] {
      background-color: var(--color-accent);
      color: var(--color-foreground);
    }
  }
</style>
