---
/**
 * The source of a showcase example, shown literally: the notation
 * transformers are left out, so `// [!code ++]` reads as text.
 */
import { Code as AstroCode } from "astro:components";
import { defaultCodeTransformers } from "@cloudflare/nimbus-docs/runtime";

type Props = Parameters<typeof AstroCode>[0];
const props = Astro.props as Props;
const transformers = defaultCodeTransformers().filter((t) => !t.name?.includes(":notation-"));
---

<AstroCode
  {...props}
  themes={{ light: "github-light", dark: "github-dark" }}
  defaultColor={false}
  transformers={transformers as Props["transformers"]}
/>
