---
/* The Nimbus logo: a hand-drawn cloud, inline so it takes the text colour and follows light and dark.
   `latest` (default, Oct 12 2026) is a filled drawing. `v0` is the earlier pen outline; its `weight`
   traces it with a matching round stroke, thickening every line evenly. */
interface Props { class?: string; variant?: "latest" | "v0"; weight?: number }
import { NIMBUS_LOGO_PATHS } from "@/components/nimbus-logo";
const { class: cls = "h-6 w-auto", variant = "latest", weight = 6 } = Astro.props;
const pad = weight / 2 + 1;
const v0Box = `${1279.2699982518484 - pad} ${1182.8866554300782 - pad} ${514.5661214491075 + pad * 2} ${223.36036137623594 + pad * 2}`;
const latest = NIMBUS_LOGO_PATHS;
---
