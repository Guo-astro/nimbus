---
/**
 * One `sidebar: "on-demand"` navigation fragment: a collapsed API group,
 * rendered by the site's own `ApiSidebarItem` so loaded rows are the same
 * markup as the rest of the sidebar. Nimbus injects this route per collection
 * at `/nimbus-api/nav/<collection>/[...slug]`; the sidebar script moves the
 * group's content into the page when the group opens. Not a public component.
 */
import ApiSidebarItem from "virtual:nimbus/api-sidebar-item";
import {
  getApiNavFragment,
  getApiNavFragmentPaths,
} from "virtual:nimbus/api-nav-fragment-runtime";

export const partial = true;
export const getStaticPaths = getApiNavFragmentPaths;

const fragment = await getApiNavFragment(Astro);
if (fragment instanceof Response) return fragment;
---

<!-- Not a page: kept out of search indexes (the sitemap skips the route too). -->
<div data-pagefind-ignore="all">
  <ApiSidebarItem item={fragment.item} />
</div>
