---
/**
 * ApiSidebarLoader — the script behind `sidebar: "on-demand"` groups. Rendered
 * only inside a deferred group, so pages without one ship no extra script
 * (Astro emits a component's script only where the component renders). It
 * fills a group's empty panel from its fragment on first open.
 */
---

<script>
  import { deferContent, mount } from "@cloudflare/nimbus-docs/client";

  mount("[data-nb-nav-src]", (root) => {
    const trigger = root.querySelector<HTMLElement>("[data-nb-collapsible-trigger]");
    const content = root.querySelector<HTMLElement>("[data-nb-collapsible-content]");
    if (!trigger || !content) return () => {};
    const loader = deferContent({
      trigger,
      content,
      src: root.dataset.nbNavSrc!,
      select: "[data-nb-collapsible-content]",
      fallbackHref: root.dataset.nbNavFallback,
      loaded: root.dataset.nbNavDeferred === undefined,
    });
    return () => loader.destroy();
  });
</script>
