---
/**
 * ShowcaseLayout — three-column chrome for the component showcase route.
 *
 * Left: components sidebar (grouped by category).
 * Right: section TOC.
 * Center: the showcase content (hero, preview stage, sections).
 *
 * Reuses the docs Sidebar + TOC components so the chrome matches the rest
 * of the site; the distinctive showcase treatment lives in the content,
 * not the frame.
 */
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import MobileSidebar from "@/components/MobileSidebar.astro";
import { Sidebar, SidebarFilter } from "@/components/ui/sidebar";
import { TOC } from "@/components/ui/toc";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";
import type { SidebarItem, TOCItem } from "@cloudflare/nimbus-docs/types";

interface Props extends BasePageProps {
  sidebar: SidebarItem[];
  headings: TOCItem[];
}

const { sidebar, headings, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  <div class="flex flex-col min-h-screen">
    <Header />

    <div class="flex-1 mx-auto w-full">
      <div class="flex">
        <aside
          id="desktop-sidebar"
          class="hidden md:flex w-(--nb-sidebar-width) shrink-0 border-e border-border sticky top-(--nb-header-height) h-[calc(100vh-3.5rem)] flex-col relative"
        >
          {/* One tree per page: it moves into the phone menu while that is open. */}
          <div data-nb-sidebar-tree class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
            <nav class="px-4 pb-12 pt-5">
              <SidebarFilter />
              <Sidebar items={sidebar} persist />
            </nav>
          </div>
          <div class="pointer-events-none sticky bottom-0 h-8 bg-gradient-to-t from-base to-transparent" />
        </aside>

        <main id="main-content" transition:name="nb-content" class="flex-1 min-w-0">
          <slot />
        </main>

        <aside data-nb-toc-scroll-host class="hidden xl:block w-(--nb-toc-width) shrink-0 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
          <div class="pt-6 pb-8 ps-8 pe-6">
            <TOC headings={headings} />
          </div>
        </aside>
      </div>
    </div>
  </div>

  <MobileSidebar label="Components navigation" />
</BaseLayout>
