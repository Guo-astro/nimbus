---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LinkButton } from "@/components/ui/link-button";
import { SearchTrigger } from "@/components/ui/search";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

const homeHref = withBase("/", import.meta.env.BASE_URL);
const quickstartHref = withBase("/start-here/quickstart", import.meta.env.BASE_URL);
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist or has moved."
  noindex
>
  <main
    id="main-content"
    class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-2xl flex-col items-start justify-center gap-6 px-6 py-24"
  >
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="text-4xl font-semibold tracking-tight text-foreground">
      Page not found
    </h1>
    <p class="text-base text-muted-foreground">
      The page you are looking for does not exist or has moved. Search for it, or start from the quickstart.
    </p>
    <SearchTrigger />
    <div class="mt-2 flex flex-wrap gap-3">
      <LinkButton href={quickstartHref} variant="primary" icon>Quickstart</LinkButton>
      <LinkButton href={homeHref} variant="secondary">Back to home</LinkButton>
    </div>
  </main>
</BaseLayout>
